# Ignore some basic stuff
home-assistant*
core
appdaemon/appdaemon.yaml
*.pyc
*.log
*.cache

# Exclude .db and .json files not inside custom_components
*.db*
*.json
!custom_components/**

# Ignore folders.
.storage
.cloud
.google.token

# Ensure these YAML files are ignored, otherwise your secret data/credentials will leak.
ip_bans.yaml
secrets.yaml
known_devices.yaml

# Solcast temp files
solcast*

# Bambu cache files
www/media/ha-bambulab/**/prints/*

# Tibber graph
www/tibber*.png

# TTS files
tts/*

# Lock files
*.lock

file_notifications/*.txt

# Solar Forecast ML
solar_forecast_ml/

# Grid Price Monitor logs
grid_price_monitor/logs/

# HA Washdata
custom_components/ha_washdata/www/*.gz
www/ha_washdata/feedback/

# Backups
data_backups/
*.tar.gz

# Debug
debug/

.DS_Store
